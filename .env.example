# Copy to .env.local for local dev, and set these in Vercel Project Settings → Environment Variables.

# --- Public (safe to expose to the browser) ---
# The dashboard reads the open aggregate tables with the publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://gwnzktbegeseyfiofzkb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server only (NEVER expose, NEVER commit) ---
# The /api/ingest and /api/mapping routes use this to write to fact_txn /
# map_account_group and to rebuild aggregates.
# Get it from Supabase → Project Settings → API → service_role key.
SUPABASE_URL=https://gwnzktbegeseyfiofzkb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Shared secret that gates the WRITE path of /api/mapping (the account→KPI group
# editor at /admin). Must be at least 24 characters; use a random 32+ char value:
#   openssl rand -base64 32
# Fails closed: while this is unset, /admin renders read-only and every mapping
# edit and rebuild is refused with 503. Not NEXT_PUBLIC — never sent to the
# browser by the server; the operator types it into /admin to unlock writes.
ADMIN_API_TOKEN=
