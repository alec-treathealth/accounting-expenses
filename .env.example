# Copy to .env.local for local dev, and set these in Vercel Project Settings → Environment Variables.

# --- Public (safe to expose to the browser) ---
# The dashboard reads the open aggregate tables with the publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://gwnzktbegeseyfiofzkb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server only (NEVER expose, NEVER commit) ---
# The /api/ingest route uses this to write to fact_txn and rebuild aggregates,
# and /api/txn uses it to READ fact_txn (which is RLS-private with no policies).
# Get it from Supabase → Project Settings → API → service_role key.
SUPABASE_URL=https://gwnzktbegeseyfiofzkb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# --- Transaction drill-down (/api/txn) ---
# Off unless this is exactly "true": no transaction detail is served otherwise.
TXN_DRILLDOWN_ENABLED=true
# Optional shared secret for scripted/ops reads:
#   curl -H "x-drilldown-token: …" https://…/api/txn?facility=…&month=…
# Browser use does not need it. Leave unset to disable non-browser access.
# TXN_DRILLDOWN_TOKEN=
# Only set this if the deployment intentionally has Vercel Deployment Protection
# turned OFF and you accept that /api/txn is then reachable by anyone who can
# reach the deployment. See README → "Drill-down authorization".
# TXN_ALLOW_UNPROTECTED=true
